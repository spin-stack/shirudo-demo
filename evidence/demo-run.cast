[2.062, "o", "## kernel\r\n7.4.0-rc4\r\n## /proc/cmdline\r\nconsole=ttyS0 quiet loglevel=3 root=/dev/vda rw rootfstype=ext4 pci=lastbus=0 panic=1 net.ifnames=0 biosdevname=0 systemd.unified_cgroup_hierarchy=1 cgroup_no_v1=all memhp_default_state=online no_timer_check tsc=reliable TERM=dumb bpf.keyring_unsealed=1 dm_verity.keyring_unsealed=1 systemd.tpm2_measured_os=1 systemd.set_credential_binary=tmpfiles.extra:ZCAvcnVuL3N5c3RlbWQvbmV0d29yayAwNzU1IC0gLSAtCmYrIC9ydW4vc3lzdGVtZC9uZXR3b3JrLzUwLXBhc3N0Lm5ldHdvcmsgMDY0NCAtIC0gLSBbTWF0Y2hdXG5OYW1lPWV0aDBcbltOZXR3b3JrXVxuQWRkcmVzcz0xMC4wLjIuMTUvMjRcbkdhdGV3YXk9MTAuMC4yLjJcbgpmKyAvZXRjL3Jlc29sdi5jb25mIDA2NDQgLSAtIC0gbmFtZXNlcnZlciAxMC4wLjIuM1xuCg== systemd.set_credential_binary=udev.rules.50-passt.rules:U1VCU1lTVEVNPT0ibmV0IiwgQUNUSU9OPT0iYWRkIiwgS0VSTkVMPT0iZXRoMCIsIFRBRys9InN5c3RlbWQiLCBFTlZ7U1lTVEVNRF9XQU5UU30rPSJzeXN0ZW1kLW5ldHdvcmtkLnNlcnZpY2UiCg== systemd.set_credential=agetty.autologin:root systemd.show_status=true\r\n## lockdown\r\nnone [integrity] confidentiality\r\n## lsm\r\nlockdown,capability,bpf\r\n## TPM\r\n/dev/tpm0 Dcrw-rw----\r\n/dev/tpmrm0 Dcrw-rw----\r\n## ip addr\r\n1: lo: <LOOPBACK,UP,LOWER_UP> mtu 65536 qdisc noqueue state UNKNOWN group default qlen 1000\r\n    link/loopback 00:00:00:00:00:00 brd 00:00:00:00:00:00\r\n    inet 127.0.0.1/8 scope host lo\r\n       valid_lft forever preferred_lft forever\r\n    inet6 ::1/128 scope host noprefixroute \r\n       valid_lft forever preferred_lft forever\r\n2: eth0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500 qdisc fq_codel state UP group default qlen 1000\r\n    link/ether 52:54:00:12:34:56 brd ff:ff:ff:ff:ff:ff\r\n    altname enp0s16\r\n    altname enx525400123456\r\n    inet 10.0.2.15/24 brd 10.0.2.255 scope global eth0\r\n       valid_lft forever preferred_lft forever\r\n    inet6 fe80::5054:ff:fe12:3456/64 scope link proto kernel_ll \r\n       valid_lft forever preferred_lft forever\r\n3: sit0@NONE: <NOARP> mtu 1480 qdisc noop state DOWN group default qlen 